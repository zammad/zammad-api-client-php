{
    "name": "zammad/zammad-api-client-php",
    "type": "library",
    "description": "PSR-compliant Zammad API client for PHP 8.1+",
    "homepage": "https://github.com/zammad/zammad-api-client-php",
    "keywords": ["zammad", "api", "psr-18", "psr-17", "ticketing"],
    "license": ["AGPL-3.0", "MIT"],
    "authors": [
        { "name": "Zammad GmbH", "homepage": "https://zammad.com" }
    ],
    "require": {
        "php": ">=8.1",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "guzzlehttp/guzzle": "^7.10",
        "guzzlehttp/psr7": "^2.7",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "mockery/mockery": "^1.6",
        "phpstan/phpstan": "^1.12",
        "league/openapi-psr7-validator": "^0.22",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "suggest": {
        "symfony/http-client": "^6.4 || ^7.0 || ^8.0 — alternative PSR-18 transport",
        "symfony/serializer": "^6.4 || ^7.0 || ^8.0 — alternative DTO hydration (replaces manual fromArray)",
        "symfony/cache": "^6.4 || ^7.0 || ^8.0 — PSR-6/16 cache for response caching",
        "illuminate/support": "^12.0 || ^13.0 — Laravel ServiceProvider integration",
        "symfony/dependency-injection": "^6.4 || ^7.0 || ^8.0 — Symfony Bundle integration",
        "symfony/http-kernel": "^6.4 || ^7.0 || ^8.0 — Symfony Bundle integration"
    },
    "autoload": {
        "psr-4": { "ZammadAPIClient\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "ZammadAPIClient\\Tests\\": "test/" }
    },
    "scripts": {
        "cs": "phpcs",
        "cs:fix": "phpcbf",
        "stan": "phpstan analyse --memory-limit=1G",
        "test": "XDEBUG_MODE=off php vendor/bin/phpunit --testsuite=unit --no-coverage",
        "test:coverage": "php -d xdebug.mode=coverage vendor/bin/phpunit --testsuite=unit",
        "test:integration": "phpunit --testsuite=integration --group=integration",
        "bridge:install": [
            "composer install -d test/Bridge/Symfony --no-interaction",
            "composer install -d test/Bridge/Laravel --no-interaction"
        ],
        "test:bridge": [
            "php -d memory_limit=1G test/Bridge/Symfony/vendor/bin/phpstan analyse -c test/Bridge/Symfony/phpstan.neon.dist --no-progress",
            "XDEBUG_MODE=off test/Bridge/Symfony/vendor/bin/phpunit -c test/Bridge/Symfony/phpunit.xml.dist --no-coverage",
            "php -d memory_limit=1G test/Bridge/Laravel/vendor/bin/phpstan analyse -c test/Bridge/Laravel/phpstan.neon.dist --no-progress",
            "XDEBUG_MODE=off test/Bridge/Laravel/vendor/bin/phpunit -c test/Bridge/Laravel/phpunit.xml.dist --no-coverage"
        ],
        "post-install-cmd": [
            "php bin/install-git-hooks"
        ],
        "post-update-cmd": [
            "php bin/install-git-hooks"
        ]
    },
    "extra": {
        "laravel": {
            "providers": ["ZammadAPIClient\\Bridge\\LaravelServiceProvider"]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
